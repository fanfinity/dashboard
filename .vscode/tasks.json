{
  // Run these from the command palette: "Tasks: Run Task".
  // Login shell so nvm/pnpm resolve — VS Code tasks otherwise run a
  // non-login zsh that never sources .zprofile.
  "version": "2.0.0",
  "options": {
    "shell": { "executable": "/bin/zsh", "args": ["-l", "-c"] }
  },
  "tasks": [
    {
      "label": "Dev server",
      "detail": "pnpm dev — quasar dev with HMR",
      "type": "shell",
      "command": "pnpm dev",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dashboard"
      },
      "problemMatcher": []
    },
    {
      "label": "CDP API docs",
      "detail": "pnpm docs:cdp — Scalar API reference for openapi/sfere-cdp-contract.yaml on :3001",
      "type": "shell",
      "command": "pnpm docs:cdp",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dashboard-docs"
      },
      "problemMatcher": []
    },
    {
      "label": "Dev server + CDP docs",
      "detail": "Dev server + the browsable reference for openapi/sfere-cdp-contract.yaml, for working on a screen whose endpoint is only proposed.",
      "dependsOn": ["Dev server", "CDP API docs"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Contract: build",
      "detail": "pnpm contract:build — regenerate openapi/sfere-cdp-contract.yaml from openapi/sfere-api.json (shipped) + openapi/cdp-proposals.mjs (proposed)",
      "type": "shell",
      "command": "pnpm contract:build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Contract: JSON export",
      "detail": "pnpm contract:json — reserialise the contract to openapi/sfere-cdp-contract.json for a tool that will not read YAML. Read-only and gitignored: the YAML stays the artefact, so do not commit the result.",
      "type": "shell",
      "command": "pnpm contract:json",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Contract: lint",
      "detail": "pnpm contract:lint — Spectral (spectral:oas + the sfere-* convention rules in .spectral.yaml)",
      "type": "shell",
      "command": "pnpm contract:lint",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Contract: check",
      "detail": "pnpm contract:check — validate the contract, confirm it is up to date, and diff its shipped half against openapi/sfere-api.json",
      "type": "shell",
      "command": "pnpm contract:check",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Build",
      "detail": "pnpm build — static SPA into dist/spa",
      "type": "shell",
      "command": "pnpm build",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Lint (fix)",
      "detail": "pnpm lint — oxfmt then oxlint --fix",
      "type": "shell",
      "command": "pnpm lint",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Lint (check)",
      "detail": "pnpm lint:check — CI-style, no writes",
      "type": "shell",
      "command": "pnpm lint:check",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Smoke (build + walk every route)",
      "detail": "Builds, serves dist/spa, signs in, visits every screen. Needs SMOKE_EMAIL / SMOKE_PASSWORD in .env",
      "type": "shell",
      "command": "pnpm smoke:dist",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Serve dist/spa",
      "detail": "pnpm serve:dist — serve the last build without rebuilding",
      "type": "shell",
      "command": "pnpm serve:dist",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
