node_modules

# .env files
# NOTE: because these are ignored, `git worktree add` does NOT carry .env into a
# new worktree. Always create worktrees with `pnpm worktree` — it copies .env in.
.env*
!.env.example

# Quasar core related directories
.quasar
/dist
/quasar.config.*.temporary.compiled*

