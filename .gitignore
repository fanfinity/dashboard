/src-cordova/www

# Capacitor related directories and files
/src-capacitor/www
/src-capacitor/node_modules

# Worktrees created by `pnpm worktree`
.claude/worktrees/

# Smoke-test artifacts
.playwright/

# Working notes and handover drafts — deliberately local, not shared history
todos/

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
