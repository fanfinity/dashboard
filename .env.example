# Copy to .env and fill in. `.env` is gitignored.
#
# IMPORTANT for parallel agents: `git worktree add` only carries *tracked* files,
# so a new worktree has NO .env. Without VITE_API_BASE pointing at a reachable
# backend, sign-in fails and the router's requiresAuth guard bounces every route
# to /login — which looks like "the app is broken" rather than "config is missing".
# Always create worktrees with `pnpm worktree <name>`; it copies .env across.

# --- Fanfinity backend (accounts/RBAC + auth + CDP; orval client in src/api/) -
# The one host this app calls. Auth goes through it (POST /v1/auth/token +
# /v1/auth/refresh) rather than Firebase directly, so there is no Firebase
# config here; every screen reads through it too, in the default "Real API"
# data-source mode (useMockResource.js). Point it at a backend you actually
# have: staging, or ../backend via `make run`. A screen whose endpoint is still
# drafted reports apiMissing ("No API yet") either way. No inline default in
# code beyond localhost.
VITE_API_BASE=http://localhost:8080

# There are deliberately no Firebase vars and no event-collection vars here any
# more. Sign-in is the backend's job, and so is event collection: the dashboard
# reads events from it like every other screen, so there is no ingest host, no
# write key and no server-side API key for a dev proxy to inject. If you find
# yourself adding a var pointing at a non-Sfere host, that connection belongs in
# the backend instead.

# --- Smoke tests (scripts/smoke.mjs) ----------------------------------------
# Credentials of a real account registered against VITE_API_BASE. The smoke
# script signs in through the UI (POST /v1/auth/token) to exercise the real
# login flow rather than injecting a token.
SMOKE_EMAIL=
SMOKE_PASSWORD=

# --- Build / release identity ------------------------------------------------
# Stamped by the deploy workflows, and shown in the account menu so a user can say
# which build they are looking at. Mirrors the backend's APP_VERSION/GIT_SHA:
#   staging     -> sha-<short sha>
#   production  -> vX.Y.Z (the tag `pnpm release` created)
#   PR preview  -> pr-<N>
# Left unset locally, which is why the fallback in MainLayout.vue is "dev".
VITE_APP_VERSION=
VITE_GIT_SHA=
