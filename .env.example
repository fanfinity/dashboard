# Copy to .env and fill in. `.env` is gitignored.
#
# IMPORTANT for parallel agents: `git worktree add` only carries *tracked* files,
# so a new worktree has NO .env. Without VITE_FIREBASE_*, sign-in fails and the
# router's requiresAuth guard bounces every route to /login — which looks like
# "the app is broken" rather than "config is missing".
# Always create worktrees with `pnpm worktree <name>`; it copies .env across.

# --- Fanfinity backend (accounts/RBAC + CDP; orval client in src/api/) -------
# The one host this app calls. Every screen reads through it in the default
# "Real API" data-source mode (useMockResource.js), so point it at a backend
# you actually have: staging, or ../backend via `make run`. A screen whose
# endpoint is still drafted reports apiMissing ("No API yet") either way.
VITE_API_BASE=http://localhost:8080

# --- Firebase / Identity Platform (auth) ------------------------------------
# No inline defaults. Missing values => broken login page.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DEFAULT_TENANT_ID=

# There are deliberately no event-collection vars here any more. The dashboard
# reads events from the backend (GET /v1/events) like every other screen, so
# there is no ingest host, no write key and no server-side API key for a dev
# proxy to inject. If you find yourself adding a var pointing at a non-Sfere
# host, that connection belongs in the backend instead.

# --- Smoke tests (scripts/smoke.mjs) ----------------------------------------
# Credentials of a real account in the Firebase tenant above. The smoke script
# signs in through the UI because Firebase persists to IndexedDB, which
# Playwright's storageState does not capture.
SMOKE_EMAIL=
SMOKE_PASSWORD=

# --- Build / release identity ------------------------------------------------
# Stamped by the deploy workflows, and shown in the account menu so a user can say
# which build they are looking at. Mirrors the backend's APP_VERSION/GIT_SHA:
#   staging     -> sha-<short sha>
#   production  -> vX.Y.Z (the tag `pnpm release` created)
#   PR preview  -> pr-<N>
# Left unset locally, which is why the fallback in MainLayout.vue is "dev".
VITE_APP_VERSION=
VITE_GIT_SHA=
